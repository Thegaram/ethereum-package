      "id": 5,
      "title": "Blobs per block (EL)",
      "type": "timeseries",
      "description": "Stacked payload + type-3 (user) blobs per block; red line = MAX_BLOBS ceiling. The two blob kinds share that budget, so the stack must stay under the line. The 'payload' bar is the actual per-block payload_blob_count; type-3/MAX show for every block.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
