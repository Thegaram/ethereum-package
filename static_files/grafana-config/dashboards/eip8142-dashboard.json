    {
      "id": 22,
      "title": "Engine getPayload / newPayload latency (EL)",
      "type": "timeseries",
      "description": "getPayload/newPayload handler-duration percentiles (rpc_request_duration_seconds) across versions and nodes. p95 is the stall predictor \u2014 block production is a per-slot deadline, so it's the tail that crosses the CL's getPayload limit, not the mean. p95\u2009\u226b\u2009p50 \u21d2 a few heavy blocks (tail); both high \u21d2 systemic. Amber 1s = warning band (attesters vote at SECONDS_PER_SLOT/3=4s); red 2s = CL getPayload deadline, crossing it times out production (stall). Gaps when idle/stalled.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A",
          "legendFormat": "getPayload p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_request_duration_seconds_bucket{namespace=\"engine\",method=~\"engine_getPayloadV[0-9]+\"}[$__rate_interval])))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "B",
          "legendFormat": "getPayload p50",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rpc_request_duration_seconds_bucket{namespace=\"engine\",method=~\"engine_getPayloadV[0-9]+\"}[$__rate_interval])))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "C",
          "legendFormat": "newPayload p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_request_duration_seconds_bucket{namespace=\"engine\",method=~\"engine_newPayloadV[0-9]+\"}[$__rate_interval])))"
        }
      ],
      "options": {}
    },
