          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "clamp_min(max(eip8142_block_blobs) - max(eip8142_payload_blob_count_last), 0)",
