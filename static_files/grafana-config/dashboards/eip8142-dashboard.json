    {
      "id": 19,
      "title": "BAL size: cheap estimate vs exact (EL)",
      "type": "timeseries",
      "description": "Block-access-list byte size at the builder's most recent exact measurement. 'estimate' is the cheap O(1) incremental upper bound that gates tx selection; 'exact' is the canonical-encoder measurement, taken only when the estimate puts the block near MAX_BLOBS. Recorded for every built block at finalize (per-node / builder-local), so the estimate's looseness is visible on every block, not just near the cap.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "eip8142_bal_estimated_size_bytes{service=\"$node\"}",
          "legendFormat": "estimate (upper bound)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "eip8142_bal_actual_size_bytes{service=\"$node\"}",
